# Copy to kb/.env (gitignored). Never commit real values.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_KEY=
DEFAPI_API_KEY=

# Optional tuning
JEV_MODEL=typesafe/jev-1.13
JEV_CONCURRENCY=2
JEV_MIN_INTERVAL_MS=500
# Only used for dry-run estimates before any real calls exist; once runs are
# recorded, estimates use the observed billed $/token instead.
# Docs (2026-09-23): $0.084 / 1M input tokens list, $0 output; billed ~50% of list.
JEV_INPUT_PRICE_PER_MTOK=0.084
